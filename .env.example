# Never commit the real .env. See README "Deploy" for recommended combinations.

GEMINI_API_KEY=

# --- Spend controls -------------------------------------------------------
# Run the whole app with ZERO Gemini calls (fake latency, canned levels/roasts). Use this for local dev.
GEMINI_MOCK=1
# With GEMINI_MOCK=1: return meta.fallback=true so the client's fallback state can be tested.
# GEMINI_MOCK_FALLBACK=0
# 0 = roasts come from the canned escalating pool even with a key (keep 0 until the AI narrator ships).
GEMINI_LIVE_ROAST=0
# Max REAL Gemini requests per local day (repairs count). 0 = unlimited.
GEMINI_DAILY_CAP=15
# Save every real Gemini response to server/fixtures/ (commit them), and/or serve only from fixtures.
# GEMINI_RECORD=0
# GEMINI_REPLAY=0

# --- Models, thinking, timeouts (all optional; defaults shown) ---------------
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_ROAST_MODEL=gemini-3.8-flash
# GEMINI_ROAST_THINKING=low      # low | medium | high ("minimal" is rejected by the API)
# GEMINI_LEVEL_THINKING=low
# GEMINI_ROAST_TIMEOUT_MS=2500   # client cutoff should be this + ~500ms
# Level generation has no time limit (only the roast has GEMINI_ROAST_TIMEOUT_MS)
